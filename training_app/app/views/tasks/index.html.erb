<% content_for :title, "My tasks" %>
<% total = @tasks.length; completed = @tasks.count(&:completed?); pending = total - completed %>
<section class="retro-hero" aria-labelledby="welcome-heading">
  <div class="hero-copy">
    <span class="hero-kicker">Big ideas. Retro energy.</span>
    <h1 id="welcome-heading" class="hero-title"><span>Your amazing</span><span>get-it-done era.</span></h1>
    <p class="hero-description">A little planning. A lot of personality. Bring your ideas together, check things off, and make room for whatever comes next.</p>
    <div class="hero-actions"><%= link_to new_task_path, class: "button" do %>Let’s do this <%= app_icon("arrow") %><% end %><%= link_to "Explore my tasks", "#tasks-heading", class: "text-link !text-xs" %></div>
    <p class="hero-caption"><%= app_icon("spark", css_class: "size-4") %><% if pending > 0 %><%= pluralize(pending, "task") %> waiting for your magic<% elsif total > 0 %>All done. That’s a good feeling.<% else %>Fresh start. Endless possibilities.<% end %></p>
  </div>
  <div class="hero-visual"><img class="hero-image" src="/images/retro-workspace.png" width="1312" height="1199" alt="Playful retro computer, smiling star, and notebook surrounded by colorful 90s shapes" fetchpriority="high"></div>
</section>
<div class="workspace-divider"><%= app_icon("grid") %><span>Your little corner of productivity</span></div>
<section class="stats-grid" aria-label="Task statistics">
  <div class="stat-card"><div><p class="stat-label">Total tasks</p><p class="stat-value"><%= total.to_s.rjust(2, '0') %></p></div><span class="stat-icon"><%= app_icon("grid") %></span></div>
  <div class="stat-card"><div><p class="stat-label">In progress</p><p class="stat-value"><%= pending.to_s.rjust(2, '0') %></p></div><span class="stat-icon amber"><%= app_icon("clock") %></span></div>
  <div class="stat-card"><div><p class="stat-label">Completed</p><p class="stat-value"><%= completed.to_s.rjust(2, '0') %></p></div><span class="stat-icon green"><%= app_icon("check") %></span></div>
</section>
<section aria-labelledby="tasks-heading">
  <div class="section-heading"><h2 id="tasks-heading">Small tasks. Big moves. <span class="count-chip"><%= total %></span></h2><span class="text-xs muted">Newest first</span></div>
  <% if @tasks.empty? %>
    <div class="empty-state"><span class="empty-icon"><%= app_icon("spark") %></span><h3>Your next great idea goes here.</h3><p>Give it a name, add a little detail, and let’s get this show on the road.</p><%= link_to new_task_path, class: "button" do %><%= app_icon("plus") %> Create your first task<% end %></div>
  <% else %>
    <div class="task-grid">
      <% @tasks.each do |task| %>
        <article class="task-card">
          <div class="flex items-center justify-between"><%= render "status", task: task %><%= link_to edit_task_path(task), class: "muted hover:text-grape", aria: { label: "Edit #{task.title}" } do %><%= app_icon("edit") %><% end %></div>
          <h3><%= link_to task.title, task %></h3>
          <p class="task-description"><%= task.description.presence || "Every great idea starts somewhere. Add a few details to get going." %></p>
          <div class="task-footer"><span>Added <%= task.created_at.strftime("%b %-d") %></span><%= link_to task_path(task), class: "text-link !text-xs", aria: { label: "Open #{task.title}" } do %>Open task <%= app_icon("arrow") %><% end %></div>
        </article>
      <% end %>
    </div>
  <% end %>
</section>
