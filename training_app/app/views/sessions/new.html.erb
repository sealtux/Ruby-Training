<% content_for :title, "Sign in" %>
<div class="auth-layout">
  <%= render "shared/auth_story" %>
  <section class="auth-form">
    <p class="eyebrow">Good to see you again</p><h1>Welcome back.</h1><p class="page-subtitle !mb-7">Sign in and pick up where you left off.</p>
    <%= form_with url: login_path, local: true do |form| %>
      <div class="field"><%= form.label :email, "Email address" %><%= form.email_field :email, value: params[:email], required: true, autocomplete: "email", placeholder: "you@example.com" %></div>
      <div class="field"><%= form.label :password %><%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Enter your password" %></div>
      <%= form.button class: "button w-full" do %>Sign in <%= app_icon("arrow") %><% end %>
    <% end %>
    <p class="auth-footer">New around here? <%= link_to "Create an account", signup_path, class: "text-link !text-xs" %></p>
  </section>
</div>
