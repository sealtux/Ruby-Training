<% content_for :title, @event.title %>
<section class="event-page"><div class="event-toolbar"><%= link_to "← All events", events_path, class: "text-link !text-[#398f85]" %><%= link_to "Edit event", edit_event_path(@event), class: "button !bg-[#4bafa3] !text-white hover:!bg-[#3d978d]" %></div><article class="event-form"><p class="event-date"><%= @event.schedule_label %></p><h1 class="mt-3 text-4xl font-light text-[#303735]"><%= @event.title %></h1><p class="mt-5 text-sm leading-7 text-[#68736e]"><%= @event.description.presence || "No extra details have been added yet." %></p><div class="mt-8 grid gap-5 border-y border-[#e7ede9] py-6 text-sm text-[#61706a] sm:grid-cols-2"><p><strong class="block text-[#37413d]">Where</strong><%= @event.location %></p><p><strong class="block text-[#37413d]">When</strong><%= @event.starts_at.strftime("%B %-d, %Y · %-I:%M %p") %><br>to <%= @event.ends_at.strftime("%-I:%M %p") %></p></div><section class="mt-8"><h2 class="text-xl font-light text-[#303735]">Guest list · <%= @event.guests.count %></h2><% if @event.guests.any? %><div class="mt-4 grid gap-3 sm:grid-cols-2"><% @event.guests.each do |guest| %><p class="border border-[#e4ebe6] p-4 text-sm text-[#596762]"><strong class="block text-[#35403c]"><%= guest.name %></strong><%= guest.email %></p><% end %></div><% else %><p class="mt-3 text-sm text-[#74807b]">No guests have been invited yet.</p><% end %></section><div class="mt-8"><%= button_to "Delete event", @event, method: :delete, class: "text-xs text-[#a55b5b] hover:underline", form: { data: { turbo_confirm: "Delete this event?" } } %></div></article></section>
